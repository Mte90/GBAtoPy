-- Probe BG2PD and DMA0 state in mGBA at frame 200
callbacks:add("frame", function()
    local f = emu:currentFrame()
    if f == 200 then
        local function sx(v) if v >= 0x8000 then return v - 0x10000 end return v end
        local pa = emu:read16(0x04000020)
        local pb = emu:read16(0x04000022)
        local pc = emu:read16(0x04000024)
        local pd = emu:read16(0x04000026)
        print(string.format("BG2 PA=%d PB=%d PC=%d PD=%d", sx(pa), sx(pb), sx(pc), sx(pd)))
        local dma_src = emu:read32(0x040000B0)
        local dma_dst = emu:read32(0x040000B4)
        local dma_cnt = emu:read16(0x040000B8)
        local dma_ctrl = emu:read16(0x040000BA)
        print(string.format("DMA0: src=0x%08X dst=0x%08X count=%d ctrl=0x%04X", dma_src, dma_dst, dma_cnt, dma_ctrl))
        local buf = {}
        for i = 0, 9 do buf[i+1] = emu:read16(dma_src + i*2) end
        print("DMA buf[0..9]: " .. table.concat(buf, ","))
        local vram_vals = {}
        for row = 0, 9 do vram_vals[row+1] = emu:read16(0x06000000 + row*240*2 + 120*2) end
        print("VRAM col120 row0-9: " .. table.concat(vram_vals, ","))
        os.exit(0)
    end
end)
print("Probe started, waiting for frame 200...")
